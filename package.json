{
  "name": "course2md-web",
  "version": "0.1.0",
  "private": true,
  "description": "浏览器插件：把视频页面变成带时间戳、可跳转、可润色的 Markdown 笔记",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "test": "node --test tests/core.test.mjs tests/adapters.test.mjs",
    "test:core": "node --test tests/core.test.mjs",
    "serve": "node tools/serve.mjs",
    "fast-asr": "node tools/fast-asr-server.mjs",
    "local:install": "node tools/install-local-asr.mjs",
    "local:check": "node tools/check-local-asr.mjs",
    "check:layout": "node tools/layout-check.mjs",
    "shots": "node tools/shoot.mjs",
    "icons": "node tools/make-icons.mjs",
    "check": "node tools/check-manifest.mjs && node --test tests/core.test.mjs tests/adapters.test.mjs && node tools/layout-check.mjs",
    "check:manifest": "node tools/check-manifest.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "puppeteer-core": "^25.12.0"
  }
}
